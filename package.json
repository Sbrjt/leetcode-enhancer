{
	"name": "Enhancer for Leetcode",
	"description": "A browser extension to improve the LeetCode experience",
	"version": "0.0.0-dev",
	"type": "module",
	"homepage": "https://github.com/Sbrjt/leetcode-enhancer",
	"scripts": {
		"dev": "wxt --level log",
		"dev:firefox": "wxt -b firefox --level log --mv3",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"typecheck": "tsc",
		"lint": "eslint src",
		"lint:fix": "npm run lint --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"test": "playwright test",
		"postinstall": "wxt prepare",
		"prepare": "husky"
	},
	"dependencies": {
		"@eslint-react/eslint-plugin": "^5.17.3",
		"@tanstack/react-table": "^8.21.3",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"element-ready": "^9.0.2",
		"papaparse": "^5.5.3",
		"radix-ui": "^1.6.4",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"react-icons": "^5.6.0",
		"turndown": "^7.2.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/addons-linter": "^6.16.1",
		"@types/eslint-plugin-no-unsanitized": "^4.1.0",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^26.1.1",
		"@types/papaparse": "^5.5.2",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/turndown": "^5.0.6",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/module-react": "^1.1.5",
		"addons-linter": "^10.5.0",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-github-action": "^0.3.0",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.1.0",
		"monaco-editor": "^0.56.0",
		"patchright": "^1.61.0",
		"prettier": "^3.9.5",
		"prettier-plugin-classnames": "^0.10.2",
		"prettier-plugin-merge": "^0.10.1",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.64.0",
		"vite-plugin-remove-console": "^2.2.0",
		"wxt": "^0.20.27"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		]
	},
	"links": {
		"chromeWebStore": "https://chromewebstore.google.com/detail/leetcode-enhancer/cpoclfijojgjiafnlgnhjalkaiabcjch",
		"firefoxAddon": "https://addons.mozilla.org/en-US/firefox/addon/leetcodeenhancer/",
		"funding": "https://ko-fi.com/sbrjt"
	}
}
