{
	"name": "leetcode-enhancer",
	"description": "A browser extension to improve the LeetCode experience",
	"type": "module",
	"homepage": "https://github.com/Sbrjt/leetcode-enhancer",
	"scripts": {
		"dev": "wxt --level warn",
		"dev:firefox": "wxt -b firefox --level warn",
		"build": "wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"zip": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"typecheck": "tsc",
		"lint": "eslint src",
		"lint:fix": "npm run lint --fix",
		"format": "prettier --check .",
		"format:fix": "prettier --write .",
		"deps-check": "npm-check",
		"deps-check:fix": "npm-check -u",
		"postinstall": "wxt prepare",
		"prepare": "husky"
	},
	"dependencies": {
		"element-ready": "^9.0.2",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"turndown": "^7.2.4"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.7.8",
		"@eslint/js": "^10.0.1",
		"@tailwindcss/vite": "^4.2.2",
		"@types/addons-linter": "~6.16.1",
		"@types/lodash.debounce": "^4.0.9",
		"@types/node": "^25.7.0",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@types/turndown": "^5.0.6",
		"@wxt-dev/auto-icons": "^1.1.1",
		"@wxt-dev/module-react": "^1.1.5",
		"addons-linter": "^10.5.0",
		"eslint": "^10.3.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"globals": "^17.6.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.4",
		"monaco-editor": "^0.55.1",
		"npm-check": "^6.0.1",
		"prettier": "^3.8.3",
		"prettier-plugin-organize-imports": "^4.3.0",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.3",
		"typesync": "^0.14.3",
		"wxt": "^0.20.20"
	},
	"lint-staged": {
		"src/**/*.{ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		]
	}
}
